+    const groove = [23.8, 23.2, .3, -.3, -23.2, -23.8].includes(x) ? 1 : 0;
+    result.push({ x, z: 22, groove });
+  }
+  for (const z of [11, 0, -11]) result.push({ x: -47, z, groove: 0 });
+  return result;
