+  it('routes the actual recovered event to compact recovery pulses without opaque flying casing', () => {
+    const f = fixture(), time = 12, before = JSON.stringify(f.vehicle);
+    consume.call(f.app, [{ type: 'recovered', racerId: 'player', invulnerable: 1.55 }], time);
+    expect(f.emitCrash).toHaveBeenCalledOnce();
+    const event = f.emitCrash.mock.calls[0]![0];
+    expect(event.style).toBe('recovery');
+    expect(event.severity).toBe(1.4);
+    expect(event.color).toBe('#60ff91');
+    expect(event.position).toBe(f.vehicle.position);
+    const effects = new GalacticEffectsView();
+    effects.emitCrash(event); effects.update(time + .1);
+    expect(effects.crashDebris.count).toBe(0);
+    expect(effects.explosionPlates.count).toBe(2);
+    effects.update(time + .4);
+    expect(effects.crashDebris.count).toBe(0); expect(effects.explosionPlates.count).toBe(0);
+    expect(JSON.stringify(f.vehicle)).toBe(before);
+    effects.dispose();
+  });
