+/** Four overlapping closed rounded subcaps form one rolling dust lobe.
+ * 256 triangles per lobe; built once inside +/-1.06 XZ and [0,1] Y.
+ * Active dust never rescans or rewrites its source geometry. */
+export function createContactDustGeometry(): BufferGeometry {
+  const sides = 8, bands = 4, positions: number[] = [], indices: number[] = [];
+  const billows = [
+    [-.17, -.13, .68, 1., .64],
+    [-.42, .26, .55, .62, .55],
+    [.41, .20, .58, .77, .58],
+    [.25, -.43, .48, .67, .54],
+  ] as const;
+  for (const [cx, cz, rx, height, rz] of billows) {
+    const start = positions.length / 3;
+    for (let band = 0; band < bands; band++) {
+      const phi = band / bands * Math.PI * .5;
+      for (let side = 0; side < sides; side++) {
+        const theta = side / sides * Math.PI * 2;
+        positions.push(cx + Math.cos(theta) * Math.cos(phi) * rx,
+          Math.sin(phi) * height, cz + Math.sin(theta) * Math.cos(phi) * rz);
+      }
+    }
+    const top = positions.length / 3; positions.push(cx, height, cz);
+    const base = positions.length / 3; positions.push(cx, 0, cz);
+    for (let side = 0; side < sides; side++) {
+      const next = (side + 1) % sides;
+      for (let band = 0; band < bands - 1; band++) {
+        const a = start + band * sides + side, b = start + band * sides + next;
+        indices.push(a, a + sides, b, b, a + sides, b + sides);
+      }
+      indices.push(start + (bands - 1) * sides + side, top, start + (bands - 1) * sides + next);
+      indices.push(base, start + side, start + next);
+    }
+  }
+  const geometry = new BufferGeometry();
+  geometry.setAttribute('position', new Float32BufferAttribute(positions, 3));
+  geometry.setIndex(indices); geometry.computeVertexNormals();
+  geometry.computeBoundingBox(); geometry.computeBoundingSphere();
+  return geometry;
+}
