+  /** Read rigid art once per cut; hidden procedural bodies and VFX are excluded. */
+  private measureCombatCameraSubject(): void {
+    this.combatCameraBounds.makeEmpty();
+    const view = this.playerView;
+    if (view.importedActive) {
+      view.updateWorldMatrix(true, false);
+      this.combatCameraInverse.copy(view.matrixWorld).invert();
+      for (const mesh of view.imported.geometryMeshes) {
+        mesh.updateWorldMatrix(true, false);
+        const positions = mesh.geometry.getAttribute('position');
+        if (!positions) continue;
+        if (mesh.geometry.boundingBox) this.combatCameraMeshBounds.copy(mesh.geometry.boundingBox);
+        else {
+          this.combatCameraMeshBounds.makeEmpty();
+          for (let vertex = 0; vertex < positions.count; vertex++) {
+            this.combatCameraFocus.fromBufferAttribute(positions, vertex);
+            this.combatCameraMeshBounds.expandByPoint(this.combatCameraFocus);
+          }
+        }
+        this.combatCameraMatrix.multiplyMatrices(this.combatCameraInverse, mesh.matrixWorld);
+        this.combatCameraMeshBounds.applyMatrix4(this.combatCameraMatrix);
+        this.combatCameraBounds.union(this.combatCameraMeshBounds);
+      }
+    }
+    if (this.combatCameraBounds.isEmpty()) {
+      // Procedural classes keep their established, conservatively sized envelope.
+      this.combatCameraLocalCenter.set(0, 2.8, 4);
+      this.combatCameraRadius = 17;
+    } else {
+      this.combatCameraBounds.getCenter(this.combatCameraLocalCenter);
+      this.combatCameraBounds.getSize(this.combatCameraFocus);
+      this.combatCameraRadius = this.combatCameraFocus.length() * 0.5;
+    }
+  }
