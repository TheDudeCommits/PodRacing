+    const state = this.playerState;
+    const racerIndex = this.playerView.racerIndex;
+    const visualYaw = state.orientation.yaw + time * 1.25;
+    this.combatCameraRotation.set(
+      state.orientation.pitch + 0.34 + Math.sin(time * 5.1 + racerIndex) * 0.16,
+      visualYaw,
+      state.orientation.roll + state.orientation.bank - 0.92 + Math.sin(time * 7.4 + racerIndex) * 0.34,
+      'YXZ',
+    );
+    this.combatCameraFocus.copy(this.combatCameraLocalCenter).applyEuler(this.combatCameraRotation)
+      .add(this.subject.position);
+    this.combatCameraForward.set(Math.sin(visualYaw), 0, Math.cos(visualYaw));
+    this.subject.combatFocus = this.combatCameraFocus;
